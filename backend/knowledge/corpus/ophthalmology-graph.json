  "evidence": [
    {"id": "nice-ng242-1.6.11", "source": "nice-ng242", "section": "1.6.11", "anchors": ["dme"], "scope": "英国医院眼科服务，评估是否存在 DME", "text": "评估眼部是否存在糖尿病黄斑水肿时使用 OCT。眼底照片的硬性渗出可提示进一步评估，中心受累情况需结合所需检查。"},
    {"id": "nice-ng242-1.6.4-6", "source": "nice-ng242", "section": "1.6.4–1.6.6", "anchors": ["dme"], "scope": "英国医院眼科服务，已明确中心受累的 DME", "text": "中心受累 DME 的管理分层取决于视力是否受损。在视力受损时，指南还按中央视网膜厚度是否达到 400 µm 区分建议。应用具体治疗条款前需有相应测量。"},
    {"id": "nice-ng242-1.4.2", "source": "nice-ng242", "section": "1.4.2", "anchors": ["npdr"], "scope": "英国医院眼科服务，目前未接受治疗且既往未治疗的 NPDR", "text": "中度 NPDR 可考虑每 6 至 12 个月监测，重度或极重度 NPDR 可考虑每 3 至 6 个月监测。先确认分期和既往治疗情况。"},
    {"id": "nice-ng81-1.2.1", "source": "nice-ng81", "section": "1.2.1", "anchors": ["glaucoma"], "scope": "英国慢性开角型青光眼及相关疾病的诊断", "text": "诊断评估包括标准自动视野、散瞳立体视神经和眼底检查、Goldmann 压平眼压、房角镜检查及中央角膜厚度测量。杯盘比可用于描述影像所见，确诊需综合评估。"},
    {"id": "nice-ng82-1.4.1", "source": "nice-ng82", "section": "1.4.1", "anchors": ["metamorphopsia", "amd"], "scope": "英国有视物变形、视物变小或其他视觉变化的就诊者", "text": "出现视物变形、视物变小或其他视觉变化时，眼科评估应包括眼底检查。该条款针对症状评估。"},
    {"id": "nice-ng82-1.4.6", "source": "nice-ng82", "section": "1.4.6", "anchors": ["wet_amd"], "scope": "英国临床评估疑似活动性湿性晚期 AMD", "text": "疑似活动性湿性晚期 AMD 时应紧急转诊至黄斑专科，无论患者是否报告视力受损。通常在一个工作日内发起转诊。"},
    {"id": "nice-ng82-1.4.7-9", "source": "nice-ng82", "section": "1.4.7–1.4.9", "anchors": ["wet_amd"], "scope": "英国临床评估疑似活动性湿性晚期 AMD", "text": "疑似活动性湿性晚期 AMD 时应做 OCT。临床检查和 OCT 已排除新生血管时无需眼底荧光素血管造影（FFA）。OCT 未能排除时，用 FFA 进一步确认。"},
    {"id": "nei-amd-symptoms-and-exam", "source": "nei-amd", "section": "症状以及如何检查 AMD", "anchors": ["amd"], "scope": "美国 NEI 面向公众的 AMD 健康教育", "text": "AMD 可影响中心视力，早期可能没有症状。新发现直线看起来变弯时，应尽快接受眼科评估。眼科医生可通过全面散瞳眼底检查评估 AMD，必要时加做 OCT。"},
    {"id": "cn-amd-2023-initial-exam", "source": "cn-amd-2023", "section": "第 354 页，推荐意见 1 说明第 4 点", "anchors": ["amd"], "scope": "中国眼科临床初诊评估 AMD", "text": "初诊评估可采用眼底照相和 OCT。结构 OCT 若提示可疑病灶，由眼科医生根据情况选择荧光素血管造影、吲哚菁绿血管造影或 OCT 血管成像，以进一步明确病灶。"},
    {"id": "cn-amd-2023-neovascular-imaging", "source": "cn-amd-2023", "section": "第 354 页，推荐意见 1", "anchors": ["wet_amd"], "scope": "中国眼科临床评估疑似新生血管性 AMD，需考虑 PCV 或 RAP 等分型", "text": "对新生血管性 AMD 的诊断，指南有条件推荐用结构 OCT 联合 OCT 血管成像（OCTA），推荐等级为 2B。疑似息肉样脉络膜血管病变（PCV）或视网膜血管瘤样增生（RAP）时，影像检查选择需结合具体亚型。"},
    {"id": "ada-2026-12.3-5", "source": "ada-2026", "section": "12.3–12.5", "anchors": ["dr", "dr_screening", "t1d", "t2d"], "scope": "美国糖尿病人群常规筛查", "text": "成年 1 型糖尿病患者在起病约 5 年时接受首次全面散瞳眼检查。2 型糖尿病患者在确诊时接受首次检查。既往一个或多个年度检查无视网膜病变且血糖指标达标时，可考虑每 1 至 2 年筛查。"},
    {"id": "ada-2026-12.9", "source": "ada-2026", "section": "12.9", "anchors": ["pdr", "npdr", "dme"], "scope": "美国糖尿病眼病转诊", "text": "对任何程度的 DME、中度及以上 NPDR 或任何 PDR，应及时转诊给有糖尿病视网膜病变管理经验的眼科医师。"},
    {"id": "icdr-2003-mild-npdr", "source": "icdr-2003", "section": "DR severity scale, mild NPDR", "anchors": ["microaneurysm", "npdr"], "scope": "国际临床 DR 分级，基于充分的眼底检查", "text": "ICDR 的轻度非增殖性 DR 对应仅见微血管瘤。应用该分级时，需要确认有充分观察范围，且未发现符合更高等级的其他病变。"},
    {"id": "cn-dr-2022-classification", "source": "cn-dr-2022", "section": "DR 分期、分类标准", "anchors": ["dr", "npdr", "pdr"], "scope": "中国 DR 临床分期", "text": "按有无视网膜新生血管等特征区分非增殖期和增殖期，并结合眼底病变的类型及范围分级。病例资料需保留各眼所见和图像可判读性。"},
    {"id": "cn-glaucoma-2020-poag", "source": "cn-glaucoma-2020", "section": "三、原发性开角型青光眼和高眼压症", "anchors": ["glaucoma"], "scope": "中国原发性开角型青光眼与高眼压症鉴别", "text": "开角型青光眼诊断需要结合房角、视神经与视网膜神经纤维层改变、视野等检查结果。眼压升高与青光眼性损害应分别评估。"},
    {"id": "cn-xalatan-macular-edema", "source": "cn-xalatan", "section": "注意事项，第 5 页", "anchors": ["latanoprost", "cme_risk"], "scope": "中国适利达 0.005% 滴眼液，囊样黄斑水肿风险", "text": "说明书对无晶状体眼、伴晶状体后囊袋撕裂的人工晶体眼、前房人工晶体眼及已知有囊样黄斑水肿风险的患者提出慎用。该条款属于注意事项。"},
    {"id": "us-eylea-4.2", "source": "us-eylea", "section": "4.2", "anchors": ["aflibercept", "active_inflammation"], "scope": "美国 EYLEA 2 mg 玻璃体内注射剂", "text": "活动性眼内炎症属于该产品说明书列明的禁忌。"},
    {"id": "us-timoptic-asthma", "source": "us-timoptic", "section": "Contraindications", "anchors": ["timolol", "asthma"], "scope": "美国 TIMOPTIC in OCUDOSE 滴眼液", "text": "支气管哮喘及支气管哮喘病史，属于该产品说明书列明的禁忌。"}
  ]
}
