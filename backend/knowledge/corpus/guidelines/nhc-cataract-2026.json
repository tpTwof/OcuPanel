  "evidence": [
    {
      "id": "nhc-cataract-2026-followup",
      "source": "nhc-cataract-2026",
      "section": "第五部分（二）术后随访，随访时点",
      "scope": "中国成人白内障术后，首次随访按风险分层",
      "text": "对于手术风险低且术后无并发症者，首次随访可安排在术后 48 小时内；单眼患者或早期并发症高风险者需在 24 小时内随访。后续频率由恢复情况及并发症决定。",
      "anchors": [
        "cataract_followup"
      ]
    },
    {
      "id": "nhc-cataract-2026-examination",
      "source": "nhc-cataract-2026",
      "section": "第五部分（二）术后随访，复查内容",
      "scope": "中国成人白内障手术后的随访评估",
      "text": "复查询问新出现的症状及用药情况，评估视功能、眼压和裂隙灯所见。若视力恢复低于预期，可结合情况进一步检查眼底、OCT 或视野等以寻找原因。",
      "anchors": [
        "cataract_followup"
      ]
    }
  ]
