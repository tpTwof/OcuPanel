  "evidence": [
    {
      "id": "cn-amd-treat-followup",
      "source": "cn-amd-treat-2023",
      "section": "随访与监测",
      "scope": "中国已确诊非新生血管性年龄相关性黄斑变性患者的随访",
      "anchors": [
        "amd_followup",
        "dry_amd"
      ],
      "text": "非新生血管性年龄相关性黄斑变性患者应定期随访，建议通过阿姆斯勒表自我监测视物变形与新发中心暗点。一旦出现视力下降、视物变形或中心暗点进展，应及时复查，以排查是否转为新生血管性。"
    },
    {
      "id": "cn-amd-treat-supplement",
      "source": "cn-amd-treat-2023",
      "section": "营养补充与生活方式",
      "scope": "中国中期及以上年龄相关性黄斑变性患者",
      "anchors": [
        "amd_supplement",
        "intermediate_amd"
      ],
      "text": "对中期或晚期年龄相关性黄斑变性患者，可参考 AREDS 配方补充抗氧化维生素、叶黄素与玉米黄质，以降低进展风险；对早期或无症状者尚无充分证据支持常规补充。补充前应结合饮食与全身情况由医生评估，不能替代戒烟。"
    },
    {
      "id": "cn-amd-treat-risk",
      "source": "cn-amd-treat-2023",
      "section": "危险因素与预防",
      "scope": "年龄相关性黄斑变性的风险咨询",
      "anchors": [
        "amd_risk"
      ],
      "text": "年龄、吸烟、遗传易感性与心血管疾病是年龄相关性黄斑变性的主要危险因素。戒烟是唯一有明确证据支持可干预的生活方式措施。"
    },
    {
      "id": "cn-amd-treat-atrophy",
      "source": "cn-amd-treat-2023",
      "section": "地图样萎缩",
      "scope": "中国地图样萎缩患者的识别与随访",
      "anchors": [
        "geographic_atrophy"
      ],
      "text": "地图样萎缩表现为黄斑区视网膜色素上皮与外层视网膜进行性萎缩，病程通常缓慢进展并伴中心视力逐渐下降。其处理以定期随访、延缓进展和低视力康复为主。"
    },
    {
      "id": "nei-amd-dry-what",
      "source": "nei-amd-dry",
      "section": "Dry AMD / What is dry AMD?",
      "scope": "美国 NEI 面向公众的干性 AMD 健康教育",
      "anchors": [
        "dry_amd",
        "drusen"
      ],
      "text": "干性年龄相关性黄斑变性占该病的大多数，特征为视网膜下出现玻璃膜疣与黄斑区视网膜色素上皮萎缩。早期可能没有明显症状，随病程进展出现中心视力下降或视物变形。"
    },
    {
      "id": "nei-amd-dry-lutein",
      "source": "nei-amd-dry",
      "section": "Dry AMD / Can diet prevent AMD?",
      "scope": "美国 NEI 面向公众的干性 AMD 营养咨询",
      "anchors": [
        "amd_supplement"
      ],
      "text": "富含叶黄素与玉米黄质的深绿色蔬菜及鱼类饮食与较低的 AMD 进展风险相关。是否使用营养补充剂应由医生根据分期决定，不能自行长期大剂量服用。"
    },
    {
      "id": "aao-amd-stage",
      "source": "aao-amd-2023",
      "section": "Classification / Dry AMD severity",
      "scope": "美国 AMD 分期与玻璃膜疣判读",
      "anchors": [
        "intermediate_amd",
        "drusen"
      ],
      "text": "AMD 依据玻璃膜疣大小、数量及色素上皮改变进行分期：多个中等大小玻璃膜疣或至少一个较大玻璃膜疣、伴或不伴色素改变者属于中期 AMD；存在地图样萎缩或新生血管者属于晚期。玻璃膜疣大小与数量是判断进展风险的重要依据。"
    },
    {
      "id": "aao-amd-areds",
      "source": "aao-amd-2023",
      "section": "Prevention / AREDS supplementation",
      "scope": "美国中期或晚期 AMD 的营养补充建议",
      "anchors": [
        "amd_supplement",
        "intermediate_amd"
      ],
      "text": "AREDS 与 AREDS2 配方适用于中期 AMD 或单眼晚期 AMD 患者，用以降低对侧眼进展风险。早期 AMD 患者缺乏获益证据。吸烟者不宜使用含 β-胡萝卜素的配方，可选用不含 β-胡萝卜素的 AREDS2 配方。"
    },
    {
      "id": "nice-ng82-followup-monitor",
      "source": "nice-ng82-followup",
      "section": "Monitoring / 随访",
      "scope": "英国非新生血管性年龄相关性黄斑变性患者的随访",
      "anchors": [
        "amd_followup"
      ],
      "text": "非新生血管性年龄相关性黄斑变性患者应与社区验光师或医院随访合作，定期检查视力并自我监测视物变形。出现新发视物变形或视力骤降时应尽快评估，以判断是否出现新生血管化并考虑 OCT。"
    }
  ]
}
