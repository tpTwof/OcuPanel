# OpenAI API key. Leave empty to skip LLM calls (the CV pipeline still runs).
# 注意：现在每个用户在自己账户里填自己的 key，这条只作为「服务器默认」保留。
# 用户没配置时接口返回 409，不会回退到这里的 key。
OPENAI_API_KEY=

# Model id. Optional - defaults to gpt-4.1.
# Works with any OpenAI-compatible endpoint (DeepSeek, Qwen, vLLM, Ollama, ...).
# DeepSeek 当前模型名：deepseek-flash / deepseek-v4-pro
# （旧名 deepseek-chat、deepseek-reasoner 已于 2026-07-24 下线，勿再使用）
# OPENAI_MODEL=deepseek-flash

# Optional: point the SDK at an OpenAI-compatible endpoint.
# Unset means the official OpenAI API (https://api.openai.com/v1).
# OPENAI_BASE_URL=https://api.deepseek.com

# Server binding. Defaults: 127.0.0.1:8000
# HOST=127.0.0.1
# PORT=8000

# Auto-reload on code changes (dev only, default off).
# Keep it off in normal use: reloading doubles memory (torch is reloaded too)
# and a mid-rename restart can leave the worker importing a missing module -> 500.
# RELOAD=1

# Report language: zh (default, Simplified Chinese) or en.
# Affects both the LLM output and the PDF labels.
# REPORT_LANGUAGE=zh

# Path to a CJK .ttf font used when rendering the PDF.
# Leave empty to auto-detect (Windows usually finds C:\Windows\Fonts\simhei.ttf).
# REPORT_FONT_PATH=C:\Windows\Fonts\simhei.ttf

# Per-call LLM timeout (seconds) and retry count. Keeping these bounded stops one
# stalled request from hanging the whole pipeline.
# LLM_TIMEOUT=120
# LLM_MAX_RETRIES=1

# Disable DeepSeek thinking mode for much lower latency (1 = disabled, 0 = keep thinking).
# Only applied to DeepSeek endpoints; ignored for other providers.
# LLM_DISABLE_THINKING=1

# Knowledge retrieval (evidence passages injected into the prompt).
# RAG_ENABLED=0 falls back to pure model generation, useful for A/B comparison.
# RAG_ENABLED=1
# RAG_TOP_K=4
# Relative cut-off: keep passages scoring >= this fraction of the best hit.
# RAG_MIN_SCORE=0.35

# Retrieval mode:
#   bm25   keyword only, zero deps - a Chinese query can NEVER reach an English chunk
#   vector multilingual embeddings - Chinese query does hit English chunks
#   hybrid both, merged with Reciprocal Rank Fusion (default)
# RAG_MODE=hybrid
# Multilingual embedding model, loaded directly through transformers
# (AutoModel + mean pooling, no sentence-transformers needed).
# RAG_VECTOR_MODEL=intfloat/multilingual-e5-small
# Absolute cosine cut-off for the vector route (e5 scores run high; 0.78 ~ relevant).
# RAG_VECTOR_MIN_SCORE=0.78
# RRF constant: score = sum(1 / (k + rank)). Larger = flatter.
# RAG_RRF_K=60
# Reserve slots per language so cross-lingual chunks can actually surface.
# Calibrated against the current corpus + embedding model: relevant queries score
# 0.918-0.939, irrelevant ones 0.852-0.867. RE-CALIBRATE after changing model or corpus.
# RAG_LANG_QUOTA=1
# 0.89 = midpoint of the two populations above. 0.90 was too tight on the relevant
# side (only 0.008 headroom). Startup runs retrieval.selfcheck_gate() to re-verify.
# RAG_LANG_GATE=0.89
# Max chunks taken from a single source document (0 = unlimited).
# RAG_MAX_PER_SOURCE=2

# Citation verification agent (the 7th agent): checks every [n] against the
# retrieved passage, deletes/rewrites unsupported sentences, regenerates the whole
# report if the rewrite cannot converge, and finally WITHHOLDS the report
# (no PDF, HTTP 422) when claims still cannot be grounded.
# VERIFY_ENABLED=0 turns it off (saves 1-3 LLM calls per report).
# VERIFY_ENABLED=1
# Rewrite rounds. Each round = check + rewrite. A whole-report regeneration is
# attempted at most once, after the last round.
# VERIFY_MAX_ROUNDS=2
# If the body shrinks below this many chars (or 40% of the original), the draft is
# considered gutted and a full regeneration is triggered instead of shipping it.
# VERIFY_MIN_CHARS=300

# CORS whitelist (comma separated). The page is served by this same app in
# single-server mode, so CORS is only needed for the Vite dev server on 5500.
# CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Where the React build lives. Default: ../frontend/dist
# If the directory is missing, the app runs in API-only mode.
# FRONTEND_DIST=../frontend/dist

# HuggingFace endpoint. Set to https://hf-mirror.com when huggingface.co is unreachable.
# HF_ENDPOINT=https://hf-mirror.com

# 用于加密「用户各自填的 LLM API Key」（Fernet 对称加密）。
# 首次启动若为空会自动生成并写回 backend/.env。
# 丢失＝所有用户已存的 Key 解不开，只能重新填写；请勿提交到版本库。
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# OCUPANEL_SECRET_KEY=

# SQLite 数据库固定放在 backend/ocupanel.db（不随 .env 变化），
# 存 users / llm_configs / conversations / messages / reports 五张表。
# 该文件含账户与密文 Key，已加入 .gitignore，删除它等于清空所有账户。
