      "forbidden_conclusions": [
        "用 FLAIR 差值确定分期或黄斑水肿",
        "给出抗 VEGF 具体剂量或注射间隔"
      ]
    },
    {
      "id": "eval-amd-wet",
      "diseases": ["age_related_macular_degeneration"],
      "laterality": "right",
      "synthetic": true,
      "note": "右眼近两周视物变形，中心视力下降，OCT 见视网膜下液。左眼既往干性 AMD。",
      "findings": {
        "age_related_macular_degeneration": {
          "prompt_similarity_margin": 2.1,
          "warnings": []
