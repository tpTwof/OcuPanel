{
  "version": 1,
  "description": "报告流程评估病例集（合成/固定输入）。用于离线验证流程与状态，不替代临床专业复核。expected_questions 只描述问题主题与病种，不锁定模型措辞；required_evidence_topics 用关键词描述应能检索到的依据类型。",
  "cases": [
    {
      "id": "eval-glaucoma-typical",
      "diseases": ["glaucoma"],
      "laterality": "right",
      "synthetic": true,
      "note": "右眼眼压 26 mmHg，C/D 0.7，视野检查示鼻侧阶梯。既往诊断：原发性开角型青光眼。左眼未提供检查。",
      "findings": {
        "glaucoma": {
          "probability": 0.82,
          "measurements": {"area_equivalent_cdr": 0.72},
          "warnings": []
        }
      },
      "expected_questions": [
        {"topic": "interpretation", "disease": "glaucoma"},
        {"topic": "diagnosis", "disease": "glaucoma"},
        {"topic": "followup", "disease": "glaucoma"}
      ],
      "required_evidence_topics": ["眼压", "视野", "目标眼压"],
      "forbidden_conclusions": [
        "由模型概率或杯盘比直接写出确诊",
        "推断未提供的左眼结果",
        "给出未经证据支持的随访间隔或剂量"
      ]
    },
    {
      "id": "eval-glaucoma-missing-info",
      "diseases": ["glaucoma"],
      "laterality": null,
      "synthetic": true,
      "note": "眼压偏高，建议进一步检查。",
      "findings": {
        "glaucoma": {
          "probability": 0.61,
          "measurements": {},
          "warnings": ["No optic disc rim detected; CDR is unavailable."]
        }
      },
      "expected_questions": [
        {"topic": "examination", "disease": "glaucoma"},
        {"topic": "diagnosis", "disease": "glaucoma"}
      ],
      "required_evidence_topics": ["眼压", "房角"],
      "forbidden_conclusions": [
        "把未提供写成未检查",
        "在眼别未标注时把影像结果写成某一眼结论",
        "编造杯盘比或视野数值"
      ]
    },
    {
      "id": "eval-dr-screening",
      "diseases": ["diabetic_retinopathy"],
      "laterality": "left",
      "synthetic": true,
      "note": "左眼眼底照相见微血管瘤与少量硬性渗出，OCT 未见黄斑水肿。糖尿病病史 8 年。",
      "findings": {
